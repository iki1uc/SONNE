window.SUITE_POP = {

    active: false,
    editing: false,

    original: "",     // Original bleibt IMMER unverändert
    workingCopy: "",  // Kopie für open.edit
    response: "",
    color: "#0f0",

    styles: {
        OK:    "#00ff00",
        NOK:   "#ff0000",
        FLOW:  "#00ffff",
        BREAK: "#ff8800",
        ECHO:  "#8888ff",
        VOID:  "#444444",
        ROOT:  "#ffffff"
    },

    // OPEN.EDIT = Rohbearbeitung
    openEdit(msg, resp) {
        this.active = true;
        this.editing = true;

        this.original = msg;        // Original sichern
        this.workingCopy = msg;     // Kopie erzeugen

        this.response = resp;
        this.color = this.styles[resp] || "#0f0";
    },

    // Bearbeitung auf der Kopie
    edit(fn) {
        if (!this.editing) return;
        this.workingCopy = fn(this.workingCopy);
    },

    // CLOSED.EDIT = Original bleibt, Kopie wird übernommen
    closeEdit() {
        this.active = false;
        this.editing = false;

        // Original bleibt unverändert
        // workingCopy ist das neue Ergebnis
    },

    render() {
        const box = document.getElementById("popup");
        if (!this.active) {
            box.style.display = "none";
            return;
        }

        const mode = this.editing ? "open.edit" : "closed.edit";
        const text = this.editing ? this.workingCopy : this.original;

        box.innerText = `${this.response} / ${mode}: ${text}`;
        box.style.display = "block";
        box.style.borderColor = this.color;
        box.style.color = this.color;
    }
};
